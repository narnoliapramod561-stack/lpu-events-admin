# -----------------------------------------------------------------------------
# LPU Events — Environment Variables Template
# -----------------------------------------------------------------------------

# Supabase Backend Configuration
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
# Server/Worker-only Service Role (NEVER expose to frontend clients)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# PostHog Product Analytics (Shared single project for Student & Admin)
VITE_POSTHOG_KEY=your-posthog-project-api-key-here
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Microsoft Clarity Session Recording & Heatmaps
VITE_CLARITY_PROJECT_ID=your-clarity-project-id-here

# Sentry Error & Performance Monitoring
VITE_SENTRY_DSN=https://your-sentry-dsn-here@o0.ingest.sentry.io/0
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=1.0.0
# Backend / Worker Sentry DSN (if using dedicated server DSN)
SENTRY_DSN=https://your-backend-sentry-dsn-here@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=1.0.0

# Google Search Console Verification (Student Website)
VITE_GOOGLE_SITE_VERIFICATION=your-google-verification-token-here

# Better Stack Uptime & Incident Monitoring Reference (External monitor targets)
# Student Portal Homepage: https://lpuevents.live/
# Student Portal Feed API: https://api.lpuevents.live/functions/v1/health
# Admin Portal: https://admin.lpuevents.live/
