# LPU Events Organizer/Admin Website
# Copy to .env.local for local development.

# Environment and logging
NODE_ENV=development
LOG_LEVEL=info

# App metadata
NEXT_PUBLIC_APP_NAME="LPU Events Admin"
NEXT_PUBLIC_APP_URL=https://www.lpueventsadmin.live

# Shared Supabase backend
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin access control
SUPER_ADMIN_EMAILS=admin@example.com,owner@example.com

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Razorpay
RAZORPAY_ENV=test
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Resend
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=noreply@lpueventsadmin.live
RESEND_FROM_NAME="LPU Events Admin"

# Cloudflare R2
CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_EVENT_IMAGES_BUCKET=lpu-events-images
R2_BACKUPS_BUCKET=backups
R2_ARCHIVE_BUCKET=archive
R2_PUBLIC_URL_PREFIX=https://cdn.lpuevents.live

# Cloudflare Turnstile
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Security
APP_SECRET=your-long-random-app-secret-string
JWT_TICKET_SECRET=your-super-secure-jwt-ticket-secret-here
ENCRYPTION_KEY=your-32-byte-hex-encryption-key-for-payloads

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# Monitoring
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-web-dsn
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_client_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Feature flags
ENABLE_ANALYTICS=true
ENABLE_ARCHIVING=true
ENABLE_EMAILS=true
ENABLE_PAYMENTS=true
