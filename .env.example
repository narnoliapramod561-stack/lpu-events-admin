# -----------------------------------------------------------------------------
# LPU Events — Admin Website Environment Variables Template
# -----------------------------------------------------------------------------

# Supabase Backend Configuration
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Cloudflare R2 Public Image CDN Delivery Domain
VITE_R2_PUBLIC_URL=https://images.lpuevents.live

# PostHog Product Analytics
VITE_POSTHOG_KEY=your-posthog-project-api-key-here
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Microsoft Clarity Session Recording
VITE_CLARITY_PROJECT_ID=your-clarity-project-id-here

# Sentry Error Monitoring
VITE_SENTRY_DSN=https://your-sentry-dsn-here@o0.ingest.sentry.io/0
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=1.0.0
