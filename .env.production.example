# LPU Events Organizer/Admin Website - Production Environment
# This is an example file. Do not commit secrets here.
# Copy to a secure location for production environment variables.

# Environment and logging
NODE_ENV=production
LOG_LEVEL=warn

# App metadata
NEXT_PUBLIC_APP_NAME="LPU Events Admin"
NEXT_PUBLIC_APP_URL=https://www.lpueventsadmin.live

# Shared Supabase backend
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-prod-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-prod-service-role-key-here

# Admin access control
SUPER_ADMIN_EMAILS=admin@example.com,owner@example.com

# Google OAuth
GOOGLE_CLIENT_ID=your-prod-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-prod-google-client-secret

# Razorpay
RAZORPAY_ENV=live
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_prod_razorpay_key_secret

# Resend
RESEND_API_KEY=re_your_prod_resend_api_key
RESEND_FROM_EMAIL=noreply@lpueventsadmin.live
RESEND_FROM_NAME="LPU Events Admin"

# Cloudflare R2
CLOUDFLARE_R2_ACCOUNT_ID=your-prod-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-prod-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-prod-r2-secret-access-key
R2_EVENT_IMAGES_BUCKET=lpu-events-images-prod
R2_BACKUPS_BUCKET=backups-prod
R2_ARCHIVE_BUCKET=archive-prod
R2_PUBLIC_URL_PREFIX=https://cdn.lpuevents.live

# Cloudflare Turnstile
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=your-prod-turnstile-site-key

# Security
APP_SECRET=your-long-random-app-secret-string-for-production
JWT_TICKET_SECRET=your-super-secure-jwt-ticket-secret-for-production
ENCRYPTION_KEY=your-32-byte-hex-encryption-key-for-production

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://your-prod-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-prod-upstash-redis-token

# Monitoring
NEXT_PUBLIC_SENTRY_DSN=https://your-prod-sentry-web-dsn
NEXT_PUBLIC_POSTHOG_KEY=phc_your-prod-posthog_client_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Feature flags
ENABLE_ANALYTICS=true
ENABLE_ARCHIVING=true
ENABLE_EMAILS=true
ENABLE_PAYMENTS=true
