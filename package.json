{
  "name": "lpu-events-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
