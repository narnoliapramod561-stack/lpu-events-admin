    "upload:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "next": "15.5.21",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@tailwindcss/postcss": "^4",
    "tailwindcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "15.5.21",
    "@eslint/eslintrc": "^3",
    "@opennextjs/cloudflare": "^1.20.2",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.12",
    "wrangler": "^4.114.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
