{
  "name": "lpu-events-admin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predeploy": "node -e \"if (!process.env.GITHUB_ACTIONS && !process.env.CF_PAGES && !process.env.CI) { console.error('\\n❌ [DEPLOY BLOCKED] Direct local wrangler deploy is permanently prohibited.\\nAll deployments must originate exclusively from GitHub via git push origin main.\\n'); process.exit(1); }\"",
    "deploy": "npm run predeploy && wrangler deploy",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "cleanup:database": "node scripts/database_cleanup.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.1",
    "@types/qrcode": "^1.5.6",
    "lucide-react": "^1.31.0",
    "posthog-js": "^1.417.2",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.4",
    "vite": "^6.4.3"
  }
}
